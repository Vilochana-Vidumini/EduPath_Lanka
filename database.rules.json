{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('userType').val() === 'Admin' || root.child('users').child(auth.uid).child('userType').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('userType').val() === 'Admin' || root.child('users').child(auth.uid).child('userType').val() === 'admin')"
      }
    },
    "students": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('userType').val() === 'Admin' || root.child('users').child(auth.uid).child('userType').val() === 'admin' || root.child('users').child(auth.uid).child('userType').val() === 'Mentor' || root.child('users').child(auth.uid).child('userType').val() === 'mentor')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('userType').val() === 'Admin' || root.child('users').child(auth.uid).child('userType').val() === 'admin')"
      }
    },
    "mentors": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('userType').val() === 'Admin' || root.child('users').child(auth.uid).child('userType').val() === 'admin')"
      }
    },
    "mentorRequests": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$requestId": {
        ".read": "auth != null && (data.child('studentUid').val() === auth.uid || data.child('mentorUid').val() === auth.uid || root.child('users').child(auth.uid).child('userType').val() === 'Admin' || root.child('users').child(auth.uid).child('userType').val() === 'admin')",
        ".write": "auth != null && (!data.exists() || data.child('studentUid').val() === auth.uid || data.child('mentorUid').val() === auth.uid || root.child('users').child(auth.uid).child('userType').val() === 'Admin' || root.child('users').child(auth.uid).child('userType').val() === 'admin')"
      }
    },
    "courses": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('userType').val() === 'Admin' || root.child('users').child(auth.uid).child('userType').val() === 'admin')"
    },
    "scholarships": {
      ".read": true,
      ".write": "auth != null && (root.child('users').child(auth.uid).child('userType').val() === 'Admin' || root.child('users').child(auth.uid).child('userType').val() === 'admin')"
    },
    "pathwayResults": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('userType').val() === 'Admin' || root.child('users').child(auth.uid).child('userType').val() === 'admin')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('userType').val() === 'Admin' || root.child('users').child(auth.uid).child('userType').val() === 'admin')"
      }
    },
    "savedCourses": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "contactMessages": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('userType').val() === 'Admin' || root.child('users').child(auth.uid).child('userType').val() === 'admin')",
      ".write": true
    }
  }
}