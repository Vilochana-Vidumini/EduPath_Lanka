{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      ".indexOn": ["userType", "role", "accountStatus", "email"],
      "$uid": {
        ".read": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        ".write": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')"
      }
    },
    "students": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      "$uid": {
        ".read": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        ".write": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')"
      }
    },
    "mentors": {
      ".read": "(query.orderByChild == 'status' && query.equalTo == 'approved') || (auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin')",
      ".indexOn": ["status"],
      "$uid": {
        ".read": "data.child('status').val() == 'approved' || (auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin'))",
        ".write": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        "status": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
        },
        "approvedAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
        },
        "approvedBy": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
        },
        "rejectionReason": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
        },
        "rejectedAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
        },
        "rejectedBy": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
        }
      }
    },
    "institutes": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      "$uid": {
        ".read": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        ".write": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        "verificationStatus": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
        },
        "status": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
        },
        "approvedAt": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
        },
        "approvedBy": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
        },
        "rejectionReason": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
        },
        "reviewNotes": {
          ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
        }
      }
    },
    "studentProfileInvitations": {
      "$invitationId": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
        ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
      }
    },
    "courses": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      ".indexOn": ["instituteUid", "status", "category", "district"],
      "$courseId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('userType').val() == 'admin' || (root.child('users').child(auth.uid).child('userType').val() == 'institute' && newData.child('instituteUid').val() == auth.uid && newData.child('status').val() != 'active' && (!data.exists() || data.child('instituteUid').val() == auth.uid)))"
      }
    },
    "scholarships": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
    },
    "courseSubmissions": {
      ".read": "auth != null",
      ".indexOn": ["instituteUid", "adminReviewStatus", "submissionStatus"],
      "$submissionId": {
        ".read": "auth != null && (data.child('instituteUid').val() == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        ".write": "auth != null && (newData.child('instituteUid').val() == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')"
      }
    },
    "courseRevisions": {
      "$revisionId": {
        ".read": "auth != null && (data.child('instituteUid').val() == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        ".write": "auth != null && (newData.child('instituteUid').val() == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')"
      }
    },
    "scholarshipSubmissions": {
      "$submissionId": {
        ".read": "auth != null && (data.child('instituteUid').val() == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        ".write": "auth != null && (newData.child('instituteUid').val() == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')"
      }
    },
    "courseAnalytics": {
      "$courseId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('userType').val() == 'admin' || root.child('users').child(auth.uid).child('userType').val() == 'institute')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
      }
    },
    "courseInquiries": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('userType').val() == 'admin' || (query.orderByChild == 'instituteUid' && query.equalTo == auth.uid))",
      ".indexOn": ["instituteUid", "courseId", "status"],
      "$inquiryId": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && (root.child('users').child(auth.uid).child('userType').val() == 'admin' || data.child('instituteUid').val() == auth.uid))",
        ".read": "auth != null && (root.child('users').child(auth.uid).child('userType').val() == 'admin' || data.child('instituteUid').val() == auth.uid)"
      }
    },
    "pathwayRules": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
    },
    "pathwayResults": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      "$uid": {
        ".read": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin' || root.child('mentorStudents').child(auth.uid).child($uid).exists())",
        ".write": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')"
      }
    },
    "pathwayDrafts": {
      "$uid": {
        ".read": "auth != null && $uid == auth.uid",
        ".write": "auth != null && $uid == auth.uid"
      }
    },
    "mentorRequests": {
      ".read": "auth != null && (root.child('users').child(auth.uid).child('userType').val() == 'admin' || (query.orderByChild == 'mentorUid' && query.equalTo == auth.uid) || (query.orderByChild == 'studentUid' && query.equalTo == auth.uid))",
      ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      ".indexOn": ["studentUid", "mentorUid", "status"],
      "$requestId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('userType').val() == 'admin' || data.child('studentUid').val() == auth.uid || data.child('mentorUid').val() == auth.uid)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('userType').val() == 'admin' || (!data.exists() && newData.child('studentUid').val() == auth.uid) || data.child('studentUid').val() == auth.uid || data.child('mentorUid').val() == auth.uid)"
      }
    },
    "studentMentors": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      "$studentUid": {
        ".read": "auth != null && ($studentUid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        "$mentorUid": {
          ".read": "auth != null && ($studentUid == auth.uid || $mentorUid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
          ".write": "auth != null && ($mentorUid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')"
        }
      }
    },
    "mentorStudents": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      "$mentorUid": {
        ".read": "auth != null && ($mentorUid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        "$studentUid": {
          ".read": "auth != null && ($studentUid == auth.uid || $mentorUid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
          ".write": "auth != null && ($mentorUid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')"
        }
      }
    },
    "mentorConversations": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      "$conversationId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('userType').val() == 'admin' || data.child('participantIds').child(auth.uid).val() == true)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('userType').val() == 'admin' || data.child('participantIds').child(auth.uid).val() == true || newData.child('participantIds').child(auth.uid).val() == true)"
      }
    },
    "guestMessages": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      ".indexOn": ["status", "createdAt"],
      "$messageId": {
        ".write": "(auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin') || (!data.exists() && newData.exists())",
        ".validate": "(auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin') || (newData.hasChildren(['messageId', 'senderType', 'fullName', 'contactNumber', 'subject', 'message', 'sourcePage', 'status', 'priority', 'createdAt', 'updatedAt']) && newData.child('messageId').val() == $messageId && newData.child('senderType').val() == 'guest' && newData.child('fullName').isString() && newData.child('fullName').val().length >= 2 && newData.child('fullName').val().length <= 120 && newData.child('contactNumber').isString() && newData.child('contactNumber').val().matches(/^(0?7[0-9]{8}|\\+947[0-9]{8})$/) && (!newData.child('email').exists() || (newData.child('email').isString() && (newData.child('email').val() == '' || newData.child('email').val().matches(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/)))) && newData.child('subject').isString() && newData.child('subject').val().length > 0 && newData.child('subject').val().length <= 120 && newData.child('message').isString() && newData.child('message').val().length >= 10 && newData.child('message').val().length <= 1000 && newData.child('sourcePage').isString() && newData.child('status').isString() && newData.child('status').val().matches(/^(new|read|in-progress|replied|closed|archived)$/) && newData.child('priority').val() == 'normal')"
      }
    },
    "contactMessages": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      ".write": true
    },
    "adminMessages": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      ".indexOn": ["senderUid", "status", "createdAt"],
      "$messageId": {
        ".write": "auth != null && (root.child('users').child(auth.uid).child('userType').val() == 'admin' || !data.exists() || data.child('senderUid').val() == auth.uid)"
      }
    },
    "conversations": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      "$conversationId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('userType').val() == 'admin' || data.child('participantIds').child(auth.uid).val() == true || $conversationId == 'admin_' + auth.uid)",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('userType').val() == 'admin' || (newData.exists() && (data.child('participantIds').child(auth.uid).val() == true || newData.child('participantIds').child(auth.uid).val() == true || $conversationId == 'admin_' + auth.uid)))"
      }
    },
    "notifications": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      "$uid": {
        ".read": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        ".write": "auth != null && ($uid == auth.uid || $uid == 'admin' || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        "$notificationId": {
          ".write": "auth != null && ($uid == auth.uid || $uid == 'admin' || root.child('users').child(auth.uid).child('userType').val() == 'admin' || (!data.exists() && newData.exists()))"
        }
      },
      "admin": {
        "$notificationId": {
          ".write": "(auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin') || (!data.exists() && newData.hasChildren(['title', 'message', 'type', 'isRead', 'relatedId', 'createdAt']) && newData.child('title').val() == 'New Ask EduPath Message' && newData.child('message').val() == 'A new guest message has been submitted through Ask EduPath.' && newData.child('type').val() == 'ASK_EDUPATH_MESSAGE' && newData.child('isRead').val() == false)"
        }
      }
    },
    "activityLogs": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      ".write": "auth != null"
    },
    "presence": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      "$uid": {
        ".read": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        ".write": "auth != null && $uid == auth.uid"
      }
    },
    "loginHistory": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      "$uid": {
        ".read": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        ".write": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')"
      }
    },
    "savedCourses": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      "$uid": {
        ".read": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        ".write": "auth != null && $uid == auth.uid"
      }
    },
    "savedScholarships": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      "$uid": {
        ".read": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        ".write": "auth != null && $uid == auth.uid"
      }
    },
    "studentProgress": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      "$uid": {
        ".read": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        ".write": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')"
      }
    },
    "careerGuides": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
    },
    "userMessages": {
      "$uid": {
        ".read": "auth != null && ($uid == auth.uid || root.child('users').child(auth.uid).child('userType').val() == 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
      }
    },
    "adminNotes": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'",
      ".write": "auth != null && root.child('users').child(auth.uid).child('userType').val() == 'admin'"
    }
  }
}
